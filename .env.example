# Optional OpenAI-compatible chat model for the additional AI research agent.
# Use a provider's documented chat-completions base URL and model ID.
# Free-LLM is a provider directory, not an inference endpoint: https://free-llm.com
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=

# Browser-visible local research-service URL; this is not a secret.
VITE_TRADINGAGENTS_API=http://localhost:4001

# TradingAgents framework provider and data keys are configured below.
# Follow its current guide for provider-specific variables and vendor coverage:
# https://github.com/TauricResearch/TradingAgents#installation-and-cli
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# GOOGLE_API_KEY=
# FRED_API_KEY=
